diff --git a/force-app/main/default/classes/NTEEmailDispatchService.cls b/force-app/main/default/classes/NTEEmailDispatchService.cls
index ce0e38e..aff9aaa 100644
--- a/force-app/main/default/classes/NTEEmailDispatchService.cls
+++ b/force-app/main/default/classes/NTEEmailDispatchService.cls
@@ -292,9 +292,9 @@ public with sharing class NTEEmailDispatchService {
         Map<String, List<Id>> idsByKind = new Map<String, List<Id>>();
         Integer acceptedCount = 0;
         for (NTE_Email_Dispatch__c dispatch : failed) {
-            if (dispatch.Status__c != 'Failed') continue;
             // A status relabelled by hand cannot outrank the retained acceptance timestamp.
             if (alreadyAccepted(dispatch)) { acceptedCount++; continue; }
+            if (dispatch.Status__c != 'Failed') continue;
             if (!idsByKind.containsKey(dispatch.Kind__c)) idsByKind.put(dispatch.Kind__c, new List<Id>());
             idsByKind.get(dispatch.Kind__c).add(targetId(dispatch));
         }
@@ -414,8 +414,8 @@ public with sharing class NTEEmailDispatchService {
         Set<String> sendingTargets = new Set<String>();
         for (NTE_Email_Dispatch__c dispatch : dispatches) {
             if (dispatch.Sent_At__c != null) {
-                // Queued by hand after acceptance: resolve the queue entry without a second send.
-                dispatch.Status__c = 'Skipped';
+                // Queued by hand after acceptance: restore the accepted status without a second send.
+                dispatch.Status__c = 'Sent';
                 dispatch.Error__c = ALREADY_ACCEPTED_GUIDANCE;
                 continue;
             }
diff --git a/force-app/main/default/classes/NTEEmailDispatchServiceTest.cls b/force-app/main/default/classes/NTEEmailDispatchServiceTest.cls
index 55d3597..70bd549 100644
--- a/force-app/main/default/classes/NTEEmailDispatchServiceTest.cls
+++ b/force-app/main/default/classes/NTEEmailDispatchServiceTest.cls
@@ -264,12 +264,37 @@ private class NTEEmailDispatchServiceTest {
         Test.stopTest();
         System.assert(!NTEEmailDispatchService.renderedHtml.containsKey(selected), 'No email is rendered for an accepted dispatch.');
         NTE_Email_Dispatch__c resolved = dispatchFor(selected);
-        System.assertEquals('Skipped', resolved.Status__c);
+        System.assertEquals('Sent', resolved.Status__c, 'The accepted status is restored, not replaced by Skipped.');
         System.assertEquals(acceptedAt, resolved.Sent_At__c);
         System.assert(resolved.Error__c.contains('Forward the original email'));
         System.assertEquals(1, [SELECT COUNT() FROM NTE_Email_Dispatch__c]);
     }
 
+    @IsTest
+    static void acceptedReminderRelabelledFailedIsNotSentAgain() {
+        configure();
+        Id selected = bookingId('EXHIBITOR');
+        NTEEmailDispatchService.DraftDTO draft = NTEEmailDispatchService.buildDraft('STAFF_DUE', new List<Id>{selected});
+        NTEEmailDispatchService.queueMessages(requestFor(draft, new Set<Id>{selected}));
+        List<Id> dispatchIds = dispatchIdsFor(selected);
+        NTEEmailDispatchService.processQueued(dispatchIds, true);
+        NTE_Email_Dispatch__c accepted = dispatchFor(selected);
+        System.assertEquals('Sent', accepted.Status__c);
+        Datetime acceptedAt = accepted.Sent_At__c;
+        System.assert(NTEEmailDispatchService.retryDispatch(accepted.Id).message.contains('already accepted'),
+            'Retrying a sent email explains why nothing was queued.');
+
+        update new NTE_Email_Dispatch__c(Id = accepted.Id, Status__c = 'Failed', Error__c = 'Recipient reported a bounce.');
+        NTEEmailDispatchService.renderedHtml.clear();
+        Test.startTest();
+        NTEEmailDispatchService.QueueResponse retry = NTEEmailDispatchService.retryFailed(dispatchIds);
+        Test.stopTest();
+        System.assertEquals(0, retry.queuedCount, 'An accepted reminder is not queued again after a relabel.');
+        System.assert(!NTEEmailDispatchService.renderedHtml.containsKey(selected), 'No second reminder is rendered.');
+        System.assertEquals(acceptedAt, dispatchFor(selected).Sent_At__c);
+        System.assertEquals(1, [SELECT COUNT() FROM NTE_Email_Dispatch__c WHERE Opportunity__c = :selected]);
+    }
+
     @IsTest
     static void failedRetryDoesNotSilentlySwitchToANewRecipient() {
         configure();
