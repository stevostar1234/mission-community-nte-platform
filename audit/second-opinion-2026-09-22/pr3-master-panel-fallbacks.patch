From 49c85f803bad22521bce0fdf580b18f32580ec82 Mon Sep 17 00:00:00 2001
From: stevostar1234 <skybasteven@gmail.com>
Date: Tue, 22 Sep 2026 20:40:34 +0100
Subject: [PATCH] Second-opinion follow-up for the Master Panel fallbacks

- "No heavy vehicle" was also offered, and accepted, for bookings whose
  applicant answered Yes but has not sent the details yet. One click moved
  such a booking out of Logistics outstanding, stopped its logistics
  reminders and removed it from report NTE_05. The PR, the review finding and
  the open workflow question only cover blank or "Not known yet"; a Yes is
  now refused with a pointer to the full record, and tested.
- The confirmation text no longer reads as if the booking stays outstanding.
- The handler holds live refreshes while its dialog is open, like the
  milestone actions, so a focus-triggered refresh cannot make the confirmed
  save return silently; dialog errors show a toast. Added to the shared
  "locks before confirmation" and "cancel" panel tests.
- The payment-method hint no longer names Stripe (which may be disabled) and
  drops the live-region role on static text.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../classes/NTE_MasterPanelController.cls     | 12 ++++++---
 .../classes/NTE_MasterPanelControllerTest.cls | 15 ++++++++---
 .../lwc/nteMasterPanel/nteMasterPanel.html    |  2 +-
 .../lwc/nteMasterPanel/nteMasterPanel.js      | 26 ++++++++++++++-----
 tests/panel-ui-stress.test.js                 |  3 ++-
 5 files changed, 41 insertions(+), 17 deletions(-)

diff --git a/force-app/main/default/classes/NTE_MasterPanelController.cls b/force-app/main/default/classes/NTE_MasterPanelController.cls
index 5576b0a..132a2bf 100644
--- a/force-app/main/default/classes/NTE_MasterPanelController.cls
+++ b/force-app/main/default/classes/NTE_MasterPanelController.cls
@@ -836,9 +836,9 @@ public with sharing class NTE_MasterPanelController {
     }
 
     /**
-     * Manual fallback for a booking whose logistics answer is blank, "Not known yet" or an
-     * unconfirmed "Yes" and for which no vehicle details were ever supplied. It records the
-     * same "No" the application form would have, so the booking can complete.
+     * Manual fallback for a booking whose logistics answer is blank or "Not known yet" and for
+     * which no vehicle details were ever supplied. It records the same "No" the application form
+     * would have, so the booking can complete. An applicant's "Yes" is changed on the full record.
      */
     @AuraEnabled
     public static ActionResult confirmNoHeavyVehicle(Id opportunityId) {
@@ -868,6 +868,9 @@ public with sharing class NTE_MasterPanelController {
             if (booking.NTE_Heavy_Vehicle_Update_Completed_At__c != null) {
                 throw handled('Vehicle details have already been supplied for this booking. Change the requirement on the full record if they no longer apply.');
             }
+            if (booking.NTE_Heavy_Vehicle_Required__c == 'Yes') {
+                throw handled('The applicant said a heavy vehicle is coming. If they have told you otherwise, change the requirement on the full record.');
+            }
             Database.update(new Opportunity(Id = booking.Id, NTE_Heavy_Vehicle_Required__c = 'No'), AccessLevel.USER_MODE);
             ActionResult result = new ActionResult();
             result.success = true;
@@ -1375,7 +1378,7 @@ public with sharing class NTE_MasterPanelController {
         // A billable booking with no recognised payment method has no request action; say why instead of showing nothing.
         row.financeActionIssue = row.baseInvoiceRequired && row.baseSendAction == null && !row.basePaymentReceived
             && !row.pricingReviewRequired && recordValue.NTE_Approval_Email_Sent_At__c == null
-            ? 'Select the payment method (Stripe or Bank transfer) on the booking to enable the payment request.' : null;
+            ? 'Set the payment method on the full record to enable the payment request.' : null;
         row.financeStatus = financeStatus(row);
         row.staffStatus = recordValue.NTE_Staff_Update_Completed_At__c == null ? 'Update required' : 'Complete';
         row.logoUpdateProvided = recordValue.NTE_Logo_Update_Provided__c;
@@ -1389,6 +1392,7 @@ public with sharing class NTE_MasterPanelController {
             row.logisticsStatus = 'Not confirmed';
         }
         row.canConfirmNoHeavyVehicle = recordValue.NTE_Heavy_Vehicle_Required__c != 'No'
+            && recordValue.NTE_Heavy_Vehicle_Required__c != 'Yes'
             && recordValue.NTE_Heavy_Vehicle_Update_Completed_At__c == null;
         row.complete = isComplete(recordValue);
         if (row.complete) row.stage = 'Completed';
diff --git a/force-app/main/default/classes/NTE_MasterPanelControllerTest.cls b/force-app/main/default/classes/NTE_MasterPanelControllerTest.cls
index 84bc225..3aea78b 100644
