diff --git a/assets/forms.js b/assets/forms.js
index 89cc38f..37c49cb 100644
--- a/assets/forms.js
+++ b/assets/forms.js
@@ -581,9 +581,20 @@
   function normalizeWebsiteAddress(value) {
     var trimmed = String(value || "").trim();
     if (!trimmed) return "";
-    // People usually type "www.example.org"; a URL field needs a scheme to be valid.
-    if (!/^[a-z][a-z0-9+.-]*:/i.test(trimmed)) trimmed = "https://" + trimmed;
-    return trimmed;
+    // People usually type "www.example.org"; the Website field stores a full web address.
+    return /^https?:\/\//i.test(trimmed) ? trimmed : "https://" + trimmed.replace(/^\/+/, "");
+  }
+
+  // Once "https://" is added, the browser's own URL check accepts almost anything
+  // ("https://N/A", "https://someone@example.org"), so require a real web host.
+  function isWebsiteAddress(value) {
+    try {
+      var address = new URL(value);
+      return /^https?:$/.test(address.protocol) && !address.username && !address.password
+        && /^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z0-9-]{2,}$/i.test(address.hostname);
+    } catch (error) {
+      return false;
+    }
   }
 
   function validateWebsiteAddresses(form) {
@@ -591,10 +602,11 @@
       if (control.disabled) return false;
       var value = normalizeWebsiteAddress(control.value);
       if (!value) return false;
+      if (!isWebsiteAddress(value)) return true;
       if (value !== String(control.value || "")) control.value = value;
-      return !control.checkValidity();
+      return false;
     });
-    return !invalid || setRuleError(form, invalid, "Enter the website address, such as https://www.example.org, or leave it blank.");
+    return !invalid || setRuleError(form, invalid, "Enter a website address such as www.example.org, or leave it blank.");
   }
 
   function formatWebToLeadDate(value) {
@@ -784,13 +796,12 @@
       // Normalise references and refresh conditional requirements before asking
       // the browser to validate; reportValidity still enforces native rules.
       form.noValidate = true;
-      // The markup ships its submit control disabled, so a page whose engine never
-      // started cannot post an unvalidated form. Enable it now the engine is ready.
-      form.querySelectorAll('[type="submit"]').forEach(function (button) { button.removeAttribute("disabled"); });
       var validateCodeOfConduct = setupCodeOfConduct(form);
+      var systemFieldsReady = true;
       try {
         populateSystemFields(form);
       } catch (error) {
+        systemFieldsReady = false;
         setStatus(form, "This form is currently unavailable. Reload the page and try again.", "error");
       }
       var honeypot = document.createElement("input");
@@ -880,6 +891,9 @@
       form.addEventListener("focusin", function (event) {
         if (event.target && event.target.type === "date") configureFieldConstraints();
       });
+      // The markup ships its submit control disabled. Enable it only once this form's
+      // set-up has finished, so a failed start can never post an unvalidated form.
+      if (systemFieldsReady) form.querySelectorAll('[type="submit"]').forEach(function (button) { button.removeAttribute("disabled"); });
     });
     if (window.addEventListener) window.addEventListener("pageshow", function () {
       configureFieldConstraints();
@@ -975,6 +989,7 @@
     qualifiesForPowerDiscount: qualifiesForPowerDiscount,
     formatWebToLeadDate: formatWebToLeadDate,
     normalizeWebsiteAddress: normalizeWebsiteAddress,
+    isWebsiteAddress: isWebsiteAddress,
     resolveReturnUrl: resolveReturnUrl
   };
 }());
